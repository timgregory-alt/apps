# --- Supabase --------------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used for privileged operations. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Automatic wine list sync -------------------------------------------------
# https://console.anthropic.com/settings/keys — used by the weekly job that
# checks each winery's website for new wines and adds them automatically.
ANTHROPIC_API_KEY=sk-ant-your-api-key
# A random secret string you choose. Vercel Cron sends it automatically as a
# Bearer token when this is set — protects the sync endpoint from outside calls.
CRON_SECRET=choose-a-random-secret-string

# --- Stripe billing ----------------------------------------------------------
# https://dashboard.stripe.com/apikeys — server-only, never expose to the client.
STRIPE_SECRET_KEY=sk_test_your-secret-key
# https://dashboard.stripe.com/webhooks — add an endpoint pointing at
# <your-domain>/api/stripe/webhook, listening for customer.subscription.created,
# customer.subscription.updated, and customer.subscription.deleted. Copy the
# signing secret it gives you here.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# https://dashboard.stripe.com/products — create one subscription product
# with a monthly and an annual Price, then paste each Price's id (starts
# with price_) here. Subscribing is disabled for a plan until its id is set.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# --- Mapbox ------------------------------------------------------------------
# https://account.mapbox.com/access-tokens/ — a public (pk.) token is fine.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token
# Optional: a custom Mapbox Studio style URL for on-brand map tiles.
# Defaults to mapbox://styles/mapbox/light-v11 if unset.
NEXT_PUBLIC_MAPBOX_STYLE=
